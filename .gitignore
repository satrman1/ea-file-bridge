# runtime data pumpy - obsahuji data z EA repozitare, do gitu nepatri
requests/
responses/

# perzistentni stav bridge (FB_StateFile v baseDir) - stanice-zavisly runtime,
# ne kanon: id posledni zapisove davky, citac spiku, W8 flag
state-*.txt

# testovaci PNG (generalka P6)
*.png

# pracovni poznamky (lokalni; plati doma i v bance)
tmp-*.md

# ostry bankovni profil buildu .github/ (tools/build-vscode.py) - jen v korporatnim repu,
# pres kuryr nikdy; vzor = config/vscode-profile.banka.example.json
config/vscode-profile.banka.json

# Python bytecode (tools/build-vscode.py, test/build-vscode.test.py)
__pycache__/
*.pyc

# log opakovaneho buildu z tools/build.cmd (prepisuje se); dukazni log prvniho buildu = docs/e2e-vscode/build-doma.log
docs/e2e-vscode/build-doma-last.log
