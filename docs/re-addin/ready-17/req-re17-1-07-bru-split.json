     "steps": [
      {
       "text": "Správce pošle pumpou dávku s operací deploy_src.",
       "kind": "actor"
      },
      {
       "text": "Systém dávku klasifikuje jako ELEVATED a zobrazí potvrzovací okno.",
       "kind": "system",
       "uses": "BRU-9501, BRU-9510, BRU-9511, BRU-9506"
      },
      {
       "text": "Správce potvrdí Ano.",
       "kind": "actor"
      },
      {
       "text": "Systém nahraje kód ze src\\ do operací prvku AICodeBridge, srovná parametry, zapíše otisk fb.code.* a audit.",
       "kind": "system"
      },
      {
       "text": "Pumpa po dávce přenačte kód z modelu (reloadCode) a zavolá start session.",
       "kind": "system"
      },
      {
       "text": "Správce plně restartuje EA, aby se nový kód projevil i v menu a dvojkliku.",
