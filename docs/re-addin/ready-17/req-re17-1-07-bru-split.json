       "text": "Správce spustí v EA Scripting skript ITAN-Bootstrap File Bridge nad balíčkem add-inu.",
       "kind": "actor"
      },
      {
       "text": "Systém založí chybějící operace, nahraje kód, srovná parametry, založí receptions EA_* a vypíše počty.",
       "kind": "system"
      },
      {
       "text": "Správce plně restartuje EA a pumpu < v0.6.",
       "kind": "actor"
      }
     ],
     "attachTo": {
      "scenario": "Basic Path",
      "step": 1
     },
     "join": "End"
    },
