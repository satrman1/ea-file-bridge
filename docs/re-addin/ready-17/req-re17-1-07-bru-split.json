  {
   "op": "create_or_update_scenarios",
   "element": "{71A761BA-9698-4bae-BB01-1A246DB6437F}",
   "scenarios": [
    {
     "name": "Basic Path",
     "type": "Basic Path",
     "steps": [
      {
       "text": "Agent uloží dávku req-<id>.json do složky requests.",
       "kind": "actor"
      },
      {
       "text": "Pumpa soubor převezme, zapíše stavový res-<id>.json (processing) a předá cestu bridge v EA.",
       "kind": "system"
      },
      {
       "text": "Systém ověří protokol a repozitář, přístup uživatele a povolené operace.",
       "kind": "system",
       "uses": "BRU-9504, BRU-9508"
      },
      {
       "text": "Systém provede předběžnou kontrolu dávky bez okna.",
       "kind": "system",
       "uses": "BRU-9505"
      },
      {
       "text": "Systém klasifikuje riziko dávky.",
       "kind": "system",
       "uses": "BRU-9501, BRU-9510, BRU-9511"
      },
      {
       "text": "Systém naplánuje a pořídí zálohu nejbližších vlastnických balíčků.",
       "kind": "system",
       "uses": "BRU-9503"
      },
      {
       "text": "Systém provede operace dávky v pořadí a zapíše změny do modelu.",
       "kind": "system",
       "uses": "BRU-9509"
      },
      {
       "text": "Systém spustí kontrolu kvality nad dotčenými balíčky a zapíše audit.",
       "kind": "system",
       "uses": "BRU-9507"
      },
      {
       "text": "Systém zapíše odpověď res-<id>.json (done), přesune dávku do processed a vypíše změny do Output tabu.",
       "kind": "system"
      },
      {
       "text": "Agent přečte odpověď a pokračuje další dávkou.",
       "kind": "actor"
      }
     ]
    },
    {
     "name": "Dávka vyžaduje potvrzení",
     "type": "Alternate",
     "steps": [
      {
       "text": "Systém vyhodnotí dávku jako ELEVATED, přesune ji do pending a zapíše odpověď confirm_required s jednorázovým nonce.",
       "kind": "system",
       "uses": "BRU-9506"
      },
      {
       "text": "Pumpa zobrazí potvrzovací okno analytikovi (UC-95102).",
       "kind": "system"
      },
      {
       "text": "Po rozhodnutí analytika systém dávku provede (pokračuje krokem 6) nebo zamítne (konec).",
       "kind": "system"
      }
     ],
     "attachTo": {
      "scenario": "Basic Path",
      "step": 5
     },
     "join": 6
    },
    {
     "name": "Dávka je jen čtecí",
     "type": "Alternate",
     "steps": [
      {
       "text": "Systém vynechá klasifikaci rizika, zálohu i kontrolu kvality a odpoví výsledkem čtení (bez okna); audit se zapíše.",
       "kind": "system"
      }
     ],
     "attachTo": {
      "scenario": "Basic Path",
      "step": 4
     },
     "join": 9
    },
    {
     "name": "Dávka odmítnuta před provedením",
     "type": "Exception",
     "steps": [
      {
       "text": "Systém odpoví jednou chybou s výčtem problémů (E_UNKNOWN_OP, E_ARGS, E_BLACKLIST, E_REPO, E_ADDIN_ACCESS, E_OP_FORBIDDEN, E_DUPLICATE_ID, E_RISK_BLOCKED, E_NO_BASELINE), nic nezapíše a dávku přesune do rejected.",
       "kind": "system"
      },
      {
       "text": "Agent opraví dávku a pošle ji pod novým id.",
       "kind": "actor"
      }
     ],
     "attachTo": {
      "scenario": "Basic Path",
      "step": 3
     },
     "join": "End"
    },
    {
     "name": "Chyba uprostřed dávky",
     "type": "Exception",
     "steps": [
      {
       "text": "Systém zastaví zbytek operací (skipped), ponechá provedené zápisy, označí dotčené prvky razítkem ai.request a vrátí partial s návodem obnovy ze zálohy.",
       "kind": "system",
       "uses": "BRU-9509"
      },
      {
       "text": "Agent podle návodu buď pokračuje opravnou dávkou, nebo požádá analytika o obnovu z baseline.",
       "kind": "actor"
      }
     ],
     "attachTo": {
      "scenario": "Basic Path",
      "step": 7
     },
     "join": "End"
    }
   ]
  },
